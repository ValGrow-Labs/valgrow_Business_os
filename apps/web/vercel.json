{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "build": {
    "env": {
      "NITRO_PRESET": "vercel"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://valgrow-api.onrender.com/:path*"
    }
  ]
}
