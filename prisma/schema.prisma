datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DEACTIVATED
}

enum OrgStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  DRAFT
  INACTIVE
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum MasterDataStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  PHYSICAL
  SERVICE
  DIGITAL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TaxType {
  GST
  VAT
  CUSTOM
}

enum PriceTier {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE_SHIPMENT
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE_WRITEOFF
  EXPIRED_WRITEOFF
  OPENING_BALANCE
  STOCK_COUNT_CORRECTION
  PRODUCTION_CONSUMPTION
  PRODUCTION_RECEIPT
}

enum TransferStatus {
  DRAFT
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum AdjustmentReason {
  DAMAGED
  LOST
  FOUND
  EXPIRED
  COUNT_CORRECTION
  OPENING_BALANCE
  MANUFACTURING_CONSUMPTION
  MANUFACTURING_RECEIPT
}

enum SerialStatus {
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  DEFECTIVE
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  EXPIRED
  CANCELLED
}

enum CostLayerStatus {
  ACTIVE
  EXHAUSTED
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CREDIT_CARD
  UPI
}

model Organization {
  id              String    @id @default(uuid())
  name            String
  legalName       String?
  slug            String    @unique
  logo            String?
  plan            String    @default("Starter")
  status          OrgStatus @default(ACTIVE)
  currency        String    @default("INR")
  timezone        String    @default("Asia/Kolkata")
  fiscalYearStart String    @default("April")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members       OrganizationMember[]
  branches      Branch[]
  departments   Department[]
  teams         Team[]
  roles         Role[]
  settings      OrganizationSettings[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  files         File[]

  categories      Category[]
  brands          Brand[]
  units           Unit[]
  taxes           Tax[]
  products        Product[]
  productVariants ProductVariant[]
  productPrices   ProductPrice[]

  warehouses     Warehouse[]
  locations      Location[]
  batches        InventoryBatch[]
  stockLevels    StockLevel[]
  costLayers     InventoryCostLayer[]
  serialNumbers  InventorySerialNumber[]
  stockMovements StockMovement[]
  transfers      StockTransfer[]
  adjustments    StockAdjustment[]
  reservations   StockReservation[]

  suppliers             Supplier[]
  supplierContacts      SupplierContact[]
  purchaseRequests      PurchaseRequest[]
  purchaseRequestItems  PurchaseRequestItem[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderItems    PurchaseOrderItem[]
  goodsReceipts         GoodsReceipt[]
  goodsReceiptItems     GoodsReceiptItem[]
  landedCostAllocations LandedCostAllocation[]
  supplierInvoices      SupplierInvoice[]
  supplierPayments      SupplierPayment[]
  documentSequences     DocumentSequence[]

  customers         Customer[]
  quotations        Quotation[]
  quotationItems    QuotationItem[]
  salesOrders       SalesOrder[]
  salesOrderItems   SalesOrderItem[]
  deliveryNotes     DeliveryNote[]
  deliveryNoteItems DeliveryNoteItem[]
  salesInvoices     SalesInvoice[]
  salesInvoiceItems SalesInvoiceItem[]
  customerPayments  CustomerPayment[]
  salesReturns      SalesReturn[]
  salesReturnItems  SalesReturnItem[]
  salesCreditNotes  SalesCreditNote[]

  posSessions POSSession[]
  posCarts    POSCart[]
  posCartItems POSCartItem[]
  posSales    POSSale[]
  posPayments POSPayment[]

  @@index([slug])
  @@index([status])
}

model User {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  email        String     @unique
  phone        String?
  passwordHash String
  avatar       String?
  jobTitle     String?
  bio          String?
  status       UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships   OrganizationMember[]
  userSettings  UserSettings[]
  sessions      Session[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  uploadedFiles File[]

  managedBranches Branch[]     @relation("BranchManager")
  headDepartments Department[] @relation("DepartmentHead")
  ledTeams        Team[]       @relation("TeamLead")

  requestedPurchases PurchaseRequest[] @relation("PurchaseRequester")
  receivedGoods      GoodsReceipt[]    @relation("GoodsReceiver")
  deliveredGoods     DeliveryNote[]    @relation("DeliveryDriver")

  openedPOSSessions POSSession[] @relation("POSSessionOpener")
  closedPOSSessions POSSession[] @relation("POSSessionCloser")
  posSales          POSSale[]    @relation("POSCashier")

  @@index([email])
  @@index([status])
}

model OrganizationMember {
  id             String     @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  status         UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String?
  city           String
  address        String?
  phone          String?
  email          String?
  status         BranchStatus @default(ACTIVE)
  managerId      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager      User?        @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  departments  Department[]
  warehouses   Warehouse[]
  quotations   Quotation[]
  salesOrders  SalesOrder[]

  posSessions POSSession[]
  posCarts    POSCart[]
  posSales    POSSale[]

  @@index([organizationId])
  @@index([status])
}

model Department {
  id             String  @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  code           String?
  description    String?
  headId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  head         User?        @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  teams        Team[]

  @@index([organizationId])
  @@index([branchId])
}

model Team {
  id             String  @id @default(uuid())
  organizationId String
  departmentId   String
  name           String
  description    String?
  leadId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lead         User?        @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([departmentId])
}

model Role {
  id             String  @id @default(uuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean @default(false)
  scope          String  @default("Organization")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@index([resource])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model OrganizationSettings {
  id             String @id @default(uuid())
  organizationId String
  key            String
  value          String
  scope          String @default("Global")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model UserSettings {
  id     String @id @default(uuid())
  userId String
  key    String
  value  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String?
  recipientId    String
  title          String
  body           String
  kind           NotificationType @default(INFO)
  unread         Boolean          @default(true)

  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([unread])
}

model ActivityLog {
  id             String  @id @default(uuid())
  organizationId String
  action         String
  entityType     String
  entityId       String?
  actorId        String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@index([createdAt])
}

model File {
  id             String   @id @default(uuid())
  organizationId String
  uploaderId     String?
  name           String
  path           String
  mimeType       String
  size           Int
  scope          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader     User?        @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  isRevoked Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Tax {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  code           String?
  rate           Decimal          @db.Decimal(5, 2)
  type           TaxType          @default(GST)
  isInclusive    Boolean          @default(false)
  status         MasterDataStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Category {
  id             String           @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  slug           String
  description    String?
  image          String?
  status         MasterDataStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]   @relation("CategoryToCategory")
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([parentId])
}

model Brand {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  slug           String
  logo           String?
  description    String?
  status         MasterDataStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Unit {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  code           String
  allowDecimals  Boolean          @default(false)
  status         MasterDataStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  categoryId     String?
  brandId        String?
  unitId         String?
  taxId          String?
  name           String
  slug           String
  sku            String?
  barcode        String?
  description    String?
  type           ProductType   @default(PHYSICAL)
  status         ProductStatus @default(ACTIVE)
  costPrice      Decimal       @default(0) @db.Decimal(12, 2)
  hasVariants    Boolean       @default(false)
  images         Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand        Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit         Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tax          Tax?             @relation(fields: [taxId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  prices       ProductPrice[]

  stockLevels          StockLevel[]
  costLayers           InventoryCostLayer[]
  batches              InventoryBatch[]
  serialNumbers        InventorySerialNumber[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]

  quotationItems    QuotationItem[]
  salesOrderItems   SalesOrderItem[]
  deliveryNoteItems DeliveryNoteItem[]
  salesInvoiceItems SalesInvoiceItem[]
  salesReturnItems  SalesReturnItem[]
  posCartItems      POSCartItem[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([categoryId])
  @@index([brandId])
}

model ProductVariant {
  id             String        @id @default(uuid())
  organizationId String
  productId      String
  name           String
  sku            String
  barcode        String?
  attributes     Json?
  status         ProductStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices       ProductPrice[]

  stockLevels          StockLevel[]
  costLayers           InventoryCostLayer[]
  batches              InventoryBatch[]
  serialNumbers        InventorySerialNumber[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]

  quotationItems    QuotationItem[]
  salesOrderItems   SalesOrderItem[]
  deliveryNoteItems DeliveryNoteItem[]
  salesInvoiceItems SalesInvoiceItem[]
  salesReturnItems  SalesReturnItem[]
  posCartItems      POSCartItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([productId])
}

model ProductPrice {
  id             String    @id @default(uuid())
  organizationId String
  productId      String
  variantId      String?
  tier           PriceTier @default(RETAIL)
  price          Decimal   @db.Decimal(12, 2)
  minQuantity    Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId, variantId, tier, minQuantity])
  @@index([organizationId])
  @@index([productId])
  @@index([variantId])
}

model Warehouse {
  id             String           @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  code           String
  address        String?
  city           String?
  isDefault      Boolean          @default(false)
  status         MasterDataStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  locations    Location[]
  stockLevels  StockLevel[]
  costLayers   InventoryCostLayer[]

  sourceTransfers StockTransfer[] @relation("SourceWarehouse")
  destTransfers   StockTransfer[] @relation("DestWarehouse")

  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]

  quotations    Quotation[]
  salesOrders   SalesOrder[]
  deliveryNotes DeliveryNote[]
  salesReturns  SalesReturn[]

  posSessions POSSession[]
  posCarts    POSCart[]
  posSales    POSSale[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([status])
}

model Location {
  id             String           @id @default(uuid())
  organizationId String
  warehouseId    String
  name           String
  code           String
  aisle          String?
  rack           String?
  shelf          String?
  bin            String?
  isDefault      Boolean          @default(false)
  status         MasterDataStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse         Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockLevels       StockLevel[]
  costLayers        InventoryCostLayer[]
  serialNumbers     InventorySerialNumber[]
  reservations      StockReservation[]
  goodsReceiptItems GoodsReceiptItem[]

  deliveryNoteItems DeliveryNoteItem[]
  salesReturnItems  SalesReturnItem[]

  @@unique([organizationId, warehouseId, code])
  @@index([organizationId])
  @@index([warehouseId])
}

model InventoryBatch {
  id              String    @id @default(uuid())
  organizationId  String
  productId       String
  variantId       String?
  batchNumber     String
  manufactureDate DateTime?
  expiryDate      DateTime?
  costPrice       Decimal   @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  stockLevels  StockLevel[]
  costLayers   InventoryCostLayer[]

  @@unique([organizationId, productId, variantId, batchNumber])
  @@index([organizationId])
  @@index([expiryDate])
}

model StockLevel {
  id              String   @id @default(uuid())
  organizationId  String
  warehouseId     String
  locationId      String
  productId       String
  variantId       String?
  batchId         String?
  onHand          Decimal  @default(0) @db.Decimal(14, 4)
  reserved        Decimal  @default(0) @db.Decimal(14, 4)
  reorderLevel    Decimal? @db.Decimal(14, 4)
  reorderQuantity Decimal? @db.Decimal(14, 4)
  version         Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batch        InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, locationId, productId, variantId, batchId])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([productId])
  @@index([variantId])
}

model InventoryCostLayer {
  id                String          @id @default(uuid())
  organizationId    String
  warehouseId       String
  locationId        String
  productId         String
  variantId         String?
  batchId           String?
  initialQty        Decimal         @db.Decimal(14, 4)
  remainingQty      Decimal         @db.Decimal(14, 4)
  baseUnitCost      Decimal?        @db.Decimal(12, 4)
  landedCostPerUnit Decimal         @default(0) @db.Decimal(12, 4)
  unitCost          Decimal         @db.Decimal(12, 4)
  status            CostLayerStatus @default(ACTIVE)
  receivedAt        DateTime        @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  batch        InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([productId])
  @@index([status])
}

model InventorySerialNumber {
  id             String       @id @default(uuid())
  organizationId String
  productId      String
  variantId      String?
  batchId        String?
  locationId     String
  serialNumber   String
  status         SerialStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  movements    StockMovement[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId])
  @@index([locationId])
  @@index([status])
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String
  branchId       String?
  warehouseId    String
  locationId     String
  productId      String
  variantId      String?
  batchId        String?
  serialNumberId String?
  serialNumber   String?
  movementType   StockMovementType
  quantity       Decimal           @db.Decimal(14, 4)
  unitCost       Decimal           @db.Decimal(12, 4)
  totalCost      Decimal           @db.Decimal(14, 4)
  referenceType  String?
  referenceId    String?
  actorId        String?
  notes          String?

  createdAt DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serial       InventorySerialNumber? @relation(fields: [serialNumberId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([locationId])
  @@index([productId])
  @@index([variantId])
  @@index([serialNumberId])
  @@index([movementType])
  @@index([createdAt])
}

model StockTransfer {
  id                String         @id @default(uuid())
  organizationId    String
  transferNumber    String
  sourceWarehouseId String
  destWarehouseId   String
  status            TransferStatus @default(DRAFT)
  notes             String?
  createdById       String
  shippedAt         DateTime?
  receivedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceWarehouse Warehouse           @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse   Warehouse           @relation("DestWarehouse", fields: [destWarehouseId], references: [id])
  items           StockTransferItem[]

  @@unique([organizationId, transferNumber])
  @@index([organizationId])
  @@index([status])
}

model StockTransferItem {
  id               String  @id @default(uuid())
  transferId       String
  productId        String
  variantId        String?
  batchId          String?
  sourceLocationId String
  destLocationId   String
  requestedQty     Decimal @db.Decimal(14, 4)
  shippedQty       Decimal @default(0) @db.Decimal(14, 4)
  receivedQty      Decimal @default(0) @db.Decimal(14, 4)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
}

model StockAdjustment {
  id               String           @id @default(uuid())
  organizationId   String
  adjustmentNumber String
  warehouseId      String
  reason           AdjustmentReason
  notes            String?
  createdById      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        StockAdjustmentItem[]

  @@unique([organizationId, adjustmentNumber])
  @@index([organizationId])
}

model StockAdjustmentItem {
  id           String  @id @default(uuid())
  adjustmentId String
  locationId   String
  productId    String
  variantId    String?
  batchId      String?
  currentQty   Decimal @db.Decimal(14, 4)
  adjustedQty  Decimal @db.Decimal(14, 4)
  newQty       Decimal @db.Decimal(14, 4)
  unitCost     Decimal @db.Decimal(12, 4)

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@index([adjustmentId])
}

model StockReservation {
  id             String            @id @default(uuid())
  organizationId String
  locationId     String
  productId      String
  variantId      String?
  batchId        String?
  quantity       Decimal           @db.Decimal(14, 4)
  referenceType  String
  referenceId    String
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([locationId])
  @@index([productId])
  @@index([status])
  @@index([expiresAt])
}

model DocumentSequence {
  id             String @id @default(uuid())
  organizationId String
  documentType   String
  year           Int
  lastSequence   Int    @default(0)

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentType, year])
  @@index([organizationId])
}

model Supplier {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  code           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?          @default("India")
  taxIdNumber    String?
  currency       String           @default("INR")
  paymentTerms   String?          @default("NET30")
  notes          String?
  status         MasterDataStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       SupplierContact[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
}

model SupplierContact {
  id             String  @id @default(uuid())
  organizationId String
  supplierId     String
  name           String
  role           String?
  email          String?
  phone          String?
  isPrimary      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierId])
}

model PurchaseRequest {
  id             String        @id @default(uuid())
  organizationId String
  requestNumber  String
  requesterId    String
  branchId       String?
  warehouseId    String
  requiredDate   DateTime?
  reason         String?
  status         RequestStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester      User                  @relation("PurchaseRequester", fields: [requesterId], references: [id])
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId])
  @@index([status])
}

model PurchaseRequestItem {
  id             String  @id @default(uuid())
  organizationId String
  requestId      String
  productId      String
  variantId      String?
  quantity       Decimal @db.Decimal(14, 4)
  estimatedCost  Decimal @default(0) @db.Decimal(12, 4)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([organizationId])
  @@index([requestId])
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  organizationId       String
  purchaseRequestId    String?
  orderNumber          String
  supplierId           String
  branchId             String?
  warehouseId          String
  currency             String              @default("INR")
  exchangeRate         Decimal             @default(1.000000) @db.Decimal(10, 6)
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  paymentTerms         String?             @default("NET30")
  notes                String?
  status               PurchaseOrderStatus @default(DRAFT)

  subtotalAmount Decimal @default(0) @db.Decimal(14, 4)
  taxAmount      Decimal @default(0) @db.Decimal(14, 4)
  discountAmount Decimal @default(0) @db.Decimal(14, 4)
  totalAmount    Decimal @default(0) @db.Decimal(14, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse           @relation(fields: [warehouseId], references: [id])
  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]
  invoices        SupplierInvoice[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id             String  @id @default(uuid())
  organizationId String
  orderId        String
  productId      String
  variantId      String?
  orderedQty     Decimal @db.Decimal(14, 4)
  receivedQty    Decimal @default(0) @db.Decimal(14, 4)
  unitPrice      Decimal @db.Decimal(12, 4)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 4)
  discountAmount Decimal @default(0) @db.Decimal(12, 4)
  totalAmount    Decimal @db.Decimal(14, 4)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id])
  variant      ProductVariant?    @relation(fields: [variantId], references: [id])
  receiptItems GoodsReceiptItem[]

  @@index([organizationId])
  @@index([orderId])
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  organizationId  String
  receiptNumber   String
  purchaseOrderId String
  supplierId      String
  warehouseId     String
  receivedById    String
  referenceNumber String?
  receivedAt      DateTime           @default(now())
  notes           String?
  status          GoodsReceiptStatus @default(POSTED)

  createdAt DateTime @default(now())

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder         PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id])
  supplier              Supplier               @relation(fields: [supplierId], references: [id])
  warehouse             Warehouse              @relation(fields: [warehouseId], references: [id])
  receivedBy            User                   @relation("GoodsReceiver", fields: [receivedById], references: [id])
  items                 GoodsReceiptItem[]
  landedCostAllocations LandedCostAllocation[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([supplierId])
}

model GoodsReceiptItem {
  id                  String    @id @default(uuid())
  organizationId      String
  goodsReceiptId      String
  purchaseOrderItemId String
  productId           String
  variantId           String?
  locationId          String
  batchNumber         String?
  manufactureDate     DateTime?
  expiryDate          DateTime?
  receivedQty         Decimal   @db.Decimal(14, 4)
  rejectedQty         Decimal   @default(0) @db.Decimal(14, 4)
  unitCost            Decimal   @db.Decimal(12, 4)
  totalCost           Decimal   @db.Decimal(14, 4)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])
  variant           ProductVariant?   @relation(fields: [variantId], references: [id])
  location          Location          @relation(fields: [locationId], references: [id])

  @@index([organizationId])
  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([locationId])
}

model LandedCostAllocation {
  id             String  @id @default(uuid())
  organizationId String
  goodsReceiptId String
  costType       String
  amount         Decimal @db.Decimal(12, 4)
  notes          String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([goodsReceiptId])
}

model SupplierInvoice {
  id              String        @id @default(uuid())
  organizationId  String
  invoiceNumber   String
  supplierId      String
  purchaseOrderId String?
  invoiceDate     DateTime
  dueDate         DateTime
  currency        String        @default("INR")
  exchangeRate    Decimal       @default(1.000000) @db.Decimal(10, 6)
  subtotalAmount  Decimal       @db.Decimal(14, 4)
  taxAmount       Decimal       @db.Decimal(14, 4)
  totalAmount     Decimal       @db.Decimal(14, 4)
  paidAmount      Decimal       @default(0) @db.Decimal(14, 4)
  status          InvoiceStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  payments      SupplierPayment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
}

model SupplierPayment {
  id                String        @id @default(uuid())
  organizationId    String
  paymentNumber     String
  supplierId        String
  supplierInvoiceId String?
  amount            Decimal       @db.Decimal(14, 4)
  paymentDate       DateTime      @default(now())
  paymentMethod     PaymentMethod @default(BANK_TRANSFER)
  referenceNumber   String?
  notes             String?

  createdAt DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier         @relation(fields: [supplierId], references: [id])
  invoice      SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id])

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([supplierId])
}

// ==================================================
// SALES DOMAIN ENUMS
// ==================================================

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  CONVERTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum DeliveryNoteStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SalesInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum CustomerPaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CREDIT_CARD
  UPI
  OTHER
}

enum SalesReturnStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SalesReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  CUSTOMER_CHANGED_MIND
  OTHER
}

enum SalesCreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  CANCELLED
}

// ==================================================
// SALES DOMAIN MODELS
// ==================================================

model Customer {
  id             String           @id @default(uuid())
  organizationId String
  customerCode   String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  country        String?          @default("India")
  taxIdNumber    String?
  currency       String           @default("INR")
  creditLimit    Decimal          @default(0) @db.Decimal(14, 4)
  paymentTerms   String?          @default("NET30")
  notes          String?
  status         MasterDataStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  quotations       Quotation[]
  salesOrders      SalesOrder[]
  deliveryNotes    DeliveryNote[]
  salesInvoices    SalesInvoice[]
  customerPayments CustomerPayment[]
  salesReturns     SalesReturn[]
  salesCreditNotes SalesCreditNote[]

  posCarts POSCart[]
  posSales POSSale[]

  @@unique([organizationId, customerCode])
  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
}

model Quotation {
  id              String          @id @default(uuid())
  organizationId  String
  quotationNumber String
  customerId      String
  branchId        String?
  warehouseId     String
  quotationDate   DateTime        @default(now())
  expiryDate      DateTime?
  currency        String          @default("INR")
  exchangeRate    Decimal         @default(1.000000) @db.Decimal(10, 6)
  subtotalAmount  Decimal         @db.Decimal(14, 4)
  discountAmount  Decimal         @default(0) @db.Decimal(14, 4)
  taxAmount       Decimal         @db.Decimal(14, 4)
  totalAmount     Decimal         @db.Decimal(14, 4)
  notes           String?
  status          QuotationStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id])
  branch       Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  items        QuotationItem[]
  salesOrders  SalesOrder[]

  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([status])
}

model QuotationItem {
  id             String  @id @default(uuid())
  organizationId String
  quotationId    String
  productId      String
  variantId      String?
  quantity       Decimal @db.Decimal(14, 4)
  unitPrice      Decimal @db.Decimal(12, 4)
  discountAmount Decimal @default(0) @db.Decimal(14, 4)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 4)
  totalAmount    Decimal @db.Decimal(14, 4)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([organizationId])
  @@index([quotationId])
  @@index([productId])
  @@index([variantId])
}

model SalesOrder {
  id                   String           @id @default(uuid())
  organizationId       String
  orderNumber          String
  customerId           String
  quotationId          String?
  branchId             String?
  warehouseId          String
  orderDate            DateTime         @default(now())
  expectedDeliveryDate DateTime?
  currency             String           @default("INR")
  exchangeRate         Decimal          @default(1.000000) @db.Decimal(10, 6)
  paymentTerms         String?          @default("NET30")
  subtotalAmount       Decimal          @db.Decimal(14, 4)
  discountAmount       Decimal          @default(0) @db.Decimal(14, 4)
  taxAmount            Decimal          @db.Decimal(14, 4)
  totalAmount          Decimal          @db.Decimal(14, 4)
  notes                String?
  status               SalesOrderStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer         @relation(fields: [customerId], references: [id])
  quotation     Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  branch        Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  items         SalesOrderItem[]
  deliveryNotes DeliveryNote[]
  salesInvoices SalesInvoice[]
  salesReturns  SalesReturn[]

  posSales POSSale[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([quotationId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([status])
}

model SalesOrderItem {
  id             String  @id @default(uuid())
  organizationId String
  salesOrderId   String
  productId      String
  variantId      String?
  orderedQty     Decimal @db.Decimal(14, 4)
  deliveredQty   Decimal @default(0) @db.Decimal(14, 4)
  unitPrice      Decimal @db.Decimal(12, 4)
  discountAmount Decimal @default(0) @db.Decimal(14, 4)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 4)
  totalAmount    Decimal @db.Decimal(14, 4)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder        SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id])
  variant           ProductVariant?    @relation(fields: [variantId], references: [id])
  deliveryNoteItems DeliveryNoteItem[]

  @@index([organizationId])
  @@index([salesOrderId])
  @@index([productId])
  @@index([variantId])
}

model DeliveryNote {
  id              String             @id @default(uuid())
  organizationId  String
  deliveryNumber  String
  salesOrderId    String
  customerId      String
  warehouseId     String
  deliveredById   String?
  deliveryDate    DateTime           @default(now())
  referenceNumber String?
  notes           String?
  status          DeliveryNoteStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder         @relation(fields: [salesOrderId], references: [id])
  customer     Customer           @relation(fields: [customerId], references: [id])
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  deliveredBy  User?              @relation("DeliveryDriver", fields: [deliveredById], references: [id])
  items        DeliveryNoteItem[]

  @@unique([organizationId, deliveryNumber])
  @@index([organizationId])
  @@index([salesOrderId])
  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
}

model DeliveryNoteItem {
  id               String  @id @default(uuid())
  organizationId   String
  deliveryNoteId   String
  salesOrderItemId String
  productId        String
  variantId        String?
  locationId       String
  quantity         Decimal @db.Decimal(14, 4)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryNote   DeliveryNote    @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem  @relation(fields: [salesOrderItemId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  location       Location        @relation(fields: [locationId], references: [id])

  @@index([organizationId])
  @@index([deliveryNoteId])
  @@index([salesOrderItemId])
  @@index([locationId])
}

model SalesInvoice {
  id             String             @id @default(uuid())
  organizationId String
  invoiceNumber  String
  customerId     String
  salesOrderId   String?
  invoiceDate    DateTime           @default(now())
  dueDate        DateTime
  currency       String             @default("INR")
  exchangeRate   Decimal            @default(1.000000) @db.Decimal(10, 6)
  subtotalAmount Decimal            @db.Decimal(14, 4)
  discountAmount Decimal            @default(0) @db.Decimal(14, 4)
  taxAmount      Decimal            @db.Decimal(14, 4)
  totalAmount    Decimal            @db.Decimal(14, 4)
  paidAmount     Decimal            @default(0) @db.Decimal(14, 4)
  status         SalesInvoiceStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer           @relation(fields: [customerId], references: [id])
  salesOrder       SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  items            SalesInvoiceItem[]
  customerPayments CustomerPayment[]
  salesReturns     SalesReturn[]
  salesCreditNotes SalesCreditNote[]

  posSales POSSale[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([salesOrderId])
  @@index([status])
}

model SalesInvoiceItem {
  id             String  @id @default(uuid())
  organizationId String
  salesInvoiceId String
  productId      String
  variantId      String?
  quantity       Decimal @db.Decimal(14, 4)
  unitPrice      Decimal @db.Decimal(12, 4)
  discountAmount Decimal @default(0) @db.Decimal(14, 4)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 4)
  totalAmount    Decimal @db.Decimal(14, 4)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesInvoice SalesInvoice    @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([organizationId])
  @@index([salesInvoiceId])
  @@index([productId])
  @@index([variantId])
}

model CustomerPayment {
  id              String                @id @default(uuid())
  organizationId  String
  paymentNumber   String
  customerId      String
  salesInvoiceId  String?
  amount          Decimal               @db.Decimal(14, 4)
  paymentDate     DateTime              @default(now())
  paymentMethod   CustomerPaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?

  createdAt DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id])
  invoice      SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([salesInvoiceId])
}

model SalesReturn {
  id                String            @id @default(uuid())
  organizationId    String
  returnNumber      String
  customerId        String
  salesOrderId      String?
  salesInvoiceId    String?
  warehouseId       String
  returnDate        DateTime          @default(now())
  totalRefundAmount Decimal           @db.Decimal(14, 4)
  notes             String?
  status            SalesReturnStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id])
  salesOrder   SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  salesInvoice SalesInvoice?     @relation(fields: [salesInvoiceId], references: [id])
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id])
  items        SalesReturnItem[]
  creditNotes  SalesCreditNote[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([salesOrderId])
  @@index([salesInvoiceId])
  @@index([warehouseId])
  @@index([status])
}

model SalesReturnItem {
  id             String            @id @default(uuid())
  organizationId String
  salesReturnId  String
  productId      String
  variantId      String?
  locationId     String
  originalQty    Decimal           @db.Decimal(14, 4)
  returnedQty    Decimal           @db.Decimal(14, 4)
  reason         SalesReturnReason @default(OTHER)
  condition      String?
  refundAmount   Decimal           @db.Decimal(14, 4)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesReturn  SalesReturn     @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  location     Location        @relation(fields: [locationId], references: [id])

  @@index([organizationId])
  @@index([salesReturnId])
  @@index([productId])
  @@index([locationId])
}

model SalesCreditNote {
  id               String                @id @default(uuid())
  organizationId   String
  creditNoteNumber String
  customerId       String
  salesInvoiceId   String?
  salesReturnId    String?
  creditDate       DateTime              @default(now())
  amount           Decimal               @db.Decimal(14, 4)
  taxAmount        Decimal               @default(0) @db.Decimal(14, 4)
  totalAmount      Decimal               @db.Decimal(14, 4)
  reason           String?
  status           SalesCreditNoteStatus @default(ISSUED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id])
  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])
  salesReturn  SalesReturn?  @relation(fields: [salesReturnId], references: [id])

  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([salesInvoiceId])
  @@index([salesReturnId])
  @@index([status])
}

// ==================================================
// POS DOMAIN ENUMS
// ==================================================

enum POSSessionStatus {
  OPEN
  CLOSED
  SUSPENDED
}

enum POSCartStatus {
  ACTIVE
  HELD
  COMPLETED
  ABANDONED
}

enum POSSaleStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

// ==================================================
// POS DOMAIN MODELS
// ==================================================

model POSSession {
  id             String           @id @default(uuid())
  organizationId String
  branchId       String
  warehouseId    String
  terminalId     String
  openedById     String
  closedById     String?
  openedAt       DateTime         @default(now())
  closedAt       DateTime?
  openingCash    Decimal          @default(0) @db.Decimal(14, 4)
  closingCash    Decimal?         @db.Decimal(14, 4)
  expectedCash   Decimal?         @db.Decimal(14, 4)
  cashDifference Decimal?         @db.Decimal(14, 4)
  notes          String?
  status         POSSessionStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  openedBy     User         @relation("POSSessionOpener", fields: [openedById], references: [id])
  closedBy     User?        @relation("POSSessionCloser", fields: [closedById], references: [id])
  carts        POSCart[]
  sales        POSSale[]

  @@index([organizationId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([terminalId])
  @@index([status])
}

model POSCart {
  id             String        @id @default(uuid())
  organizationId String
  branchId       String
  warehouseId    String
  sessionId      String
  customerId     String?
  subtotalAmount Decimal       @default(0) @db.Decimal(14, 4)
  discountAmount Decimal       @default(0) @db.Decimal(14, 4)
  taxAmount      Decimal       @default(0) @db.Decimal(14, 4)
  totalAmount    Decimal       @default(0) @db.Decimal(14, 4)
  notes          String?
  status         POSCartStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id])
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  session      POSSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id])
  items        POSCartItem[]
  sales        POSSale[]

  @@index([organizationId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([sessionId])
  @@index([customerId])
  @@index([status])
}

model POSCartItem {
  id             String  @id @default(uuid())
  organizationId String
  cartId         String
  productId      String
  variantId      String?
  quantity       Decimal @db.Decimal(14, 4)
  unitPrice      Decimal @db.Decimal(12, 4)
  discountAmount Decimal @default(0) @db.Decimal(14, 4)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 4)
  totalAmount    Decimal @db.Decimal(14, 4)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cart         POSCart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([organizationId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model POSSale {
  id             String        @id @default(uuid())
  organizationId String
  branchId       String
  warehouseId    String
  sessionId      String
  cartId         String?
  salesOrderId   String?
  salesInvoiceId String?
  receiptNumber  String
  customerId     String?
  cashierId      String
  subtotalAmount Decimal       @db.Decimal(14, 4)
  discountAmount Decimal       @default(0) @db.Decimal(14, 4)
  taxAmount      Decimal       @db.Decimal(14, 4)
  totalAmount    Decimal       @db.Decimal(14, 4)
  paidAmount     Decimal       @db.Decimal(14, 4)
  changeAmount   Decimal       @default(0) @db.Decimal(14, 4)
  status         POSSaleStatus @default(COMPLETED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id])
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  session      POSSession    @relation(fields: [sessionId], references: [id])
  cart         POSCart?      @relation(fields: [cartId], references: [id])
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  cashier      User          @relation("POSCashier", fields: [cashierId], references: [id])
  payments     POSPayment[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([sessionId])
  @@index([salesOrderId])
  @@index([salesInvoiceId])
  @@index([customerId])
  @@index([cashierId])
  @@index([status])
}

model POSPayment {
  id              String                @id @default(uuid())
  organizationId  String
  posSaleId       String
  paymentMethod   CustomerPaymentMethod @default(CASH)
  amount          Decimal               @db.Decimal(14, 4)
  receivedAmount  Decimal?              @db.Decimal(14, 4)
  changeAmount    Decimal?              @db.Decimal(14, 4)
  referenceNumber String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posSale      POSSale      @relation(fields: [posSaleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([posSaleId])
  @@index([paymentMethod])
}

