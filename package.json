{
  "name": "valgrow-business-os",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build:api": "npm run build --workspace=apps/api",
    "start:api": "node apps/api/dist/src/main.js",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "seed": "npm run seed --workspace=apps/api",
    "seed:pos-users": "npm run seed:pos-users --workspace=apps/api",
    "verify:pos-users": "npm run verify:pos-users --workspace=apps/api",
    "set-password": "npm run set-password --workspace=apps/api",
    "seed:prod": "node apps/api/dist/src/seed/seed.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps/web apps/api",
    "format": "prettier --write .",
    "test:prod-bundle": "node scripts/verify-production-manifest.mjs",
    "test:e2e-browser": "node scripts/e2e-browser-test.mjs",
    "provision:pos-accounts": "npm run provision:pos-accounts --workspace=apps/api"
  },
  "devDependencies": {
    "prettier": "^3.7.3"
  }
}
