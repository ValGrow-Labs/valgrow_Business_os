# Database
DATABASE_URL="postgresql://valgrow:valgrow_dev@localhost:5432/valgrow_db?schema=public"

# Authentication
JWT_SECRET="valgrow-dev-jwt-secret-key-change-in-production-32bytes"
JWT_REFRESH_SECRET="valgrow-dev-refresh-secret-key-change-in-production-32bytes"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
BCRYPT_ROUNDS=12

# Network Ports & URLs
API_PORT=3001
API_URL="http://localhost:3001"
WEB_URL="http://localhost:8080"
NODE_ENV="development"

# Google OAuth2 Authentication (Optional - required for "Continue with Google")
# Create OAuth 2.0 Client ID in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${API_URL}/auth/google/callback (e.g. http://localhost:3001/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=""

# Optional test user seed password (development only, do not commit production secrets)
# TEST_USER_PASSWORD=""
